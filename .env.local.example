# ───────────────────────────────────────────────────────────────
#  Justice AI — environment variables TEMPLATE
#  Copy this file to ".env.local" and fill in your keys.
#  .env.local is gitignored — never commit your real keys.
# ───────────────────────────────────────────────────────────────

# Google Gemini API key  →  https://aistudio.google.com/app/apikey
# Used by:  app/api/chat/route.ts  and  app/api/analyze-document/route.ts
GEMINI_API_KEY=
# Optional model override (default shown below).
GEMINI_MODEL=gemini-1.5-flash

# NVIDIA Nemotron API key  →  https://build.nvidia.com  (sign in → pick a Nemotron model → Get API Key)
# Used by:  app/api/draft-document/route.ts
NEMOTRON_API_KEY=
# Optional model override (default shown below). Other options:
#   nvidia/llama-3.3-nemotron-super-49b-v1
#   nvidia/llama-3.1-nemotron-70b-instruct
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
