# Justice AI setup template. Copy to .env.local; never commit actual credentials.
# All values intentionally blank. Existing .env.local values are not changed.

# Managed auth, durable Postgres and private Storage (see docs/case-workspace-setup.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Use the modern secret key or the legacy service_role key below.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy URL/anon names remain supported on the server for existing installs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional canonical app origin, e.g. http://localhost:3000 in local development.
APP_URL=

# Existing primary provider keys/models are reused. Server only.
# Gemini is primary for chat and notice analysis.
GEMINI_API_KEY=
GEMINI_MODEL=
# NVIDIA/Nemotron is primary for drafting.
NEMOTRON_API_KEY=
NEMOTRON_MODEL=
# Optional secondary model overrides; keys above are reused.
GEMINI_FALLBACK_MODEL=
NEMOTRON_FALLBACK_MODEL=
# Blank = enabled. false disables requests to the secondary processor.
AI_FALLBACK_ENABLED=
# Blank defaults: attempt12000ms, overall28000ms, 1 transient retry,
# cooldown30000ms, output2048 tokens. See docs/ai-resilience.md.
AI_ATTEMPT_TIMEOUT_MS=
AI_REQUEST_TIMEOUT_MS=
AI_RETRIES=
AI_COOLDOWN_MS=
AI_MAX_OUTPUT_TOKENS=

# OCR.space server-only credential. Digital PDF/text extraction works without it.
OCR_SPACE_API_KEY=
# Optional extraction settings. Defaults stay within the basic OCR.space limits.
# Endpoint override must match your OCR.space plan; never put keys in the URL.
OCR_SPACE_ENDPOINT=
# Default 2; supported language default eng (engine 2: eng/auto/chs/cht).
OCR_SPACE_ENGINE=
OCR_SPACE_LANGUAGE=
# Default 12000ms per OCR call, 1 MiB upload/page image, 3 OCR pages per request.
OCR_TIMEOUT_MS=
OCR_MAX_FILE_BYTES=
OCR_MAX_PAGES=

# Clerk sign-in: populate locally with clerk env pull (never expose the secret).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/cases
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/cases
